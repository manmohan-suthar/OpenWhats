PORT=8000
MONGODB_URI=mongodb://127.0.0.1:27017/openwhats
JWT_SECRET=replace-with-a-long-random-secret

# Baileys internal transport logs: silent, fatal, error, warn, info, debug, trace.
# Keep warn in production; info/debug can generate large initial-sync output.
BAILEYS_LOG_LEVEL=warn

# DeskGo -> OpenWhats first-party entitlement synchronization
DESKGO_PARTNER_ID=deskgo
DESKGO_TRUSTED_ORIGINS=https://deskgo.in,https://easyflow.suthartech.com
# Optional legacy signing/key-derivation secrets. Leave empty for first-party DeskGo/EasyFlow.
DESKGO_PARTNER_SECRET=
DESKGO_API_KEY_DERIVATION_SECRET=

# OpenWhats -> DeskGo real-time WhatsApp event delivery
DESKGO_WEBHOOK_URL=https://your-deskgo-domain.example/api/integrations/openwhats/webhook
DESKGO_WEBHOOK_SECRET=replace-with-a-separate-long-random-outbound-secret
PROVIDER_IDEMPOTENCY_RETENTION_DAYS=30

# Remote API media downloads are HTTPS-only, DNS-pinned and size bounded.
# Leave the host list empty to allow any public host, or set comma-separated domains.
REMOTE_MEDIA_ALLOWED_HOSTS=
REMOTE_MEDIA_ALLOW_HTTP=false
REMOTE_MEDIA_MAX_BYTES=26214400
REMOTE_MEDIA_TIMEOUT_MS=15000

# Stable HMAC key for hashing secret-bearing idempotency payloads (32+ chars).
# Required in production; use a value different from partner/webhook secrets.
PROVIDER_IDEMPOTENCY_SECRET=replace-with-a-different-32-character-minimum-secret

# Encrypts partner secrets saved from OpenWhats Admin Settings.
# Keep this stable across deployments (minimum 32 characters).
SETTINGS_ENCRYPTION_KEY=replace-with-a-stable-random-32-character-minimum-secret
